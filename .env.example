# API Keys Configuration
# Copy this file to .env and fill in your actual keys

# Scopus API Key (Required for Scopus searches)
# Get from: https://dev.elsevier.com/
SCOPUS_API_KEY=your_scopus_api_key_here

# PubMed/Unpaywall Email (Required for PubMed and downloads)
# Any valid email address
PUBMED_EMAIL=your.email@example.com

# PubMed API Key (Optional - increases rate limits)
# Get from: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=your_pubmed_api_key_here

# IEEE Xplore API Key (Optional - for IEEE searches)
# Get from: https://developer.ieee.org/
IEEE_API_KEY=your_ieee_api_key_here

# Unpaywall Email (Optional - uses PUBMED_EMAIL if not set)
UNPAYWALL_EMAIL=your.email@example.com

# Zotero Translation Server (Optional - primary PDF fetcher when running)
# Start with: docker run -d --name zotero-translation -p 1969:1969 zotero/translation-server
# Defaults to http://127.0.0.1:1969 if not set
ZOTERO_TRANSLATION_SERVER=http://127.0.0.1:1969