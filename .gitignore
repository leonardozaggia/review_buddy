# Environment and credentials
.env
*.env
!.env.example

# Run configuration (personal query/filters/toggles) - keep out of history.
# The tracked template is config.example.yaml.
config.yaml

# Results and outputs
# NB: scratch dirs only - do NOT use `test*/`, it also swallows the tests/ suite
test/
test_downloads/
test_out/
test_results/
test_pdfs/
results/*
# Snapshots of previous runs (results.<tag>.<epoch>/, results1/ ...) - these are
# regenerable and run to hundreds of MB.
results.*/
results[0-9]*/

# Generated knowledge-graph output
graphify-out/
*.pdf
*.bib
*.ris
*.csv

